{
  "name": "civic-order",
  "version": "0.0.1",
  "private": true,
  "description": "CIVIC ORDER — a 2D top-down enforcement-officer simulator. Browser-first, single-player.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "verify": "npm run typecheck && npm run test",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "keywords": [
    "game",
    "tactics",
    "simulation"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "pixi.js": "^8.23.0",
    "zod": "^3.25.76"
  }
}
